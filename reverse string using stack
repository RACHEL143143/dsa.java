import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner sc=new Scanner(System.in);
	String a=sc.next();
	Stack<Character> stack=new Stack<>();
	for(int i=0;i<a.length();i++){
	    stack.push(a.charAt(i));
	}
	String rev="";
	while(!stack.isEmpty()){
	    rev+=stack.pop();
	}
	System.out.print(rev);
	}
}
